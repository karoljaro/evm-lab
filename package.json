{
  "name": "evm-lab",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:typescript": "hardhat test nodejs",
    "test:production": "hardhat test --build-profile production",
    "test:coverage": "hardhat test --coverage",
    "check": "hardhat build && tsc --noEmit && hardhat test",
    "clean": "hardhat clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.8.5",
    "forge-std": "foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.18.1",
    "typescript": "~6.0.3",
    "viem": "^2.47.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
